# Supabase project URL and anon (publishable) key: Project settings → API.
# Leave both empty to run in demo mode with in-memory sample beacons.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# MapTiler API key (cloud.maptiler.com → API keys). Leave empty to use OpenStreetMap's public tiles,
# which are fine for development but not allowed for production traffic.
VITE_MAPTILER_KEY=

# Set to true once a custom SMTP sender (e.g. Resend) is configured in Supabase; until then only Google sign-in shows.
VITE_EMAIL_SIGNIN=false
